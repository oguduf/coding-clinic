{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "ScopedArtifactRead",
    "Effect": "Allow",
    "Action": ["s3:GetObject"],
    "Resource": "arn:aws:s3:::example-artifacts-bucket/releases/*"
  }, {
    "Sid": "ListArtifactBucket",
    "Effect": "Allow",
    "Action": ["s3:ListBucket"],
    "Resource": "arn:aws:s3:::example-artifacts-bucket"
  }]
}
