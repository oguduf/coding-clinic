{
  "format_version": "1.2",
  "terraform_version": "1.9.8",
  "resource_changes": [
    {
      "address": "aws_instance.web",
      "mode": "managed",
      "type": "aws_instance",
      "name": "web",
      "change": {
        "actions": ["create"],
        "after": {
          "tags": {"Environment": "dev", "Owner": "platform", "Project": "clinic"}
        },
        "after_unknown": {}
      }
    },
    {
      "address": "aws_s3_bucket.assets",
      "mode": "managed",
      "type": "aws_s3_bucket",
      "name": "assets",
      "change": {
        "actions": ["create"],
        "after": {
          "acl": "private",
          "tags_all": {"Environment": "dev", "Owner": "platform", "Project": "clinic"}
        },
        "after_unknown": {}
      }
    },
    {
      "address": "aws_s3_bucket_public_access_block.assets",
      "mode": "managed",
      "type": "aws_s3_bucket_public_access_block",
      "name": "assets",
      "change": {
        "actions": ["create"],
        "after": {
          "block_public_acls": true,
          "ignore_public_acls": true,
          "block_public_policy": true,
          "restrict_public_buckets": true
        },
        "after_unknown": {}
      }
    }
  ]
}
