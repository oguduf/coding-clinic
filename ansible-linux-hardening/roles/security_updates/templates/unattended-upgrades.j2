// Managed by Ansible role security_updates.
APT::Periodic::Update-Package-Lists "{{ 1 if security_updates_schedule == 'daily' else 7 }}";
APT::Periodic::Unattended-Upgrade "{{ 1 if security_updates_schedule == 'daily' else 7 }}";
APT::Periodic::AutocleanInterval "7";

// Drop-in lists are additive by default; clear package defaults so only the
// explicitly configured security origins below are eligible for auto-upgrades.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Allowed-Origins {
{% for origin in security_updates_ubuntu_origins %}
  "{{ origin }}";
{% endfor %}
};

Unattended-Upgrade::Automatic-Reboot "{{ 'true' if security_updates_auto_reboot | bool else 'false' }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ security_updates_auto_reboot_time }}";

